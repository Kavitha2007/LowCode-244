		workflow
		{
		form
		{
			Date_Restriction as "Date Restriction"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Date_Of_Incident > zoho.currentdate)
										{
											alert "Date of Incident cannot be a future date.";
											cancel submit;
										}
						)
					}
				}

			}
			On_Claim_Submit_Workflow as "On_Claim_Submit_Workflow"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add or edit

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "kavitha.r.2024.cse@rajalakshmi.edu.in"
							subject : "Claim Submitted Successfully - Claim Reference"
							message : "<div>${zoho.loginuserid} has added or updated a record in form Claim_Request_Form<br></div><div><br></div><div>Dear Claimant, <br></div><div><br></div><div>Your insurance claim has been successfully submitted.<br></div><div><br></div><div>Our claims team will review your claim and contact you if additional<br></div><div>documents or information are required.<br></div><div><br></div><div>Thank you,<br></div><div>Insurance Claims Team<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Missing_Document_Re as "Daily_Missing_Document_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 15:41:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
				}
			}
			Daily_Missing_Document_Re1 as "Daily_Missing_Document_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 16:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "kavitha.r.2024.cse@rajalakshmi.edu.in"
							subject : "Missing Documents Required - Insurance Claim"
							message : "<div>This is a reminder that supporting documents are still required<br></div><div>for your insurance claim.<br></div><div><br></div><div>Please submit the missing documents at the earliest so that<br></div><div>your claim can continue to be processed.<br></div><div><br></div><div>Thank you,<br></div><div>Insurance Claims Team<br></div>"
							attachments : view : Claim_Request_Form_Report as PDF
						)
					}
				}
			}
		}

		approval
		{
			HighValue_Claim_Approval as "HighValue_Claim_Approval"
			{
				type =  approval
				form = Claim_Request_Form[Net_Payable_Amount > 100000]
				display fields = [Claimant_Type,Claimant_Type1,Policy_Number,Email,Contact_Number,Residential_Address,Claim_Type]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

