 application "Insurance Claim Request & Processing Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Claim_Request_Form
		{
			success message = "Data Added Successfully!"
			Claimant_Details
			(
				type = section
				displayname = "Claimant Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Claimant_Type
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Claimant_Type1
			(
				type = radiobuttons
				displayname = "Claimant Type"
				maxchar = 100
				values = {"Policyholder","Nominee","Third Party"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Policy_Number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Details
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			allowedcountries={in}
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Claim_Details
			(
				type = section
				displayname = "Claim Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Claim_Type
			(
				type = picklist
				displayname = "Claim Type"
				maxchar = 100
				values = {"Motor Insurance","Health Insurance","Life Insurance","Property Insurance"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Date_Of_Incident
			(
    			type = date
				displayname = "Date Of Incident"
				initial value = "24-Jul-2026"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Claim_Amount_Requested
			(
				type = number
				displayname = "Claim Amount Requested"
				maxchar = 19
				initial value = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Supporting_Documents_Available
			(
				type = list	
				displayname = "Supporting Documents Available"
				values = {"Photographs","Police FIR Copy","Repair Estimate","Medical Bills","Insurance Policy Copy"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Incident_Description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Scheduling_Declaration
			(
				type = section
				displayname = "Scheduling & Declaration"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Callback_Time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Declaration_Of_Authenticity
			(
				type = checkboxes	
				displayname = "Declaration Of Authenticity"
				values = {"I declare that the information provided is true and accurate."}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Policy_Verification_Evidence
			(
				type = section
				displayname = "Policy Verification & Evidence"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Policy_Details_Lookup
			(
				type = picklist	
				displayname = "Policy Details Lookup"
				values  = Policies.ID
    			displayformat = [Policy_Number]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Damage_Photo
			(
    			type = image
				displayname = "Damage Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Repair_Estimate_Upload
			(
    			type = upload file
				displayname = "Repair Estimate Upload"
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Policy_Sum_Insured_in_Lakhs
			(
				type = decimal
				displayname = "Policy Sum Insured in Lakhs"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Witness_Media_Details
			(
				type = section
				displayname = "Witness & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			FIR_Copy_Online_Link
			(
    			type = url
				displayname = "FIR Copy Online Link"
				enable  linkname
	 			row = 6
	 			column = 1   
				width = medium
			)
			Accident_Scene_Video
			(
    			type = video
				displayname = "Accident Scene Video"
    			duration=30
	 			row = 6
	 			column = 1   
				width = medium
			)
			Incident_Voice_Statement
			(
     			type = audio
				displayname = "Incident Voice Statement"
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Witness_Details
			(
				type = grid
				displayname = "Witness Details"
				Witness_Name
				(
    				type = text
					displayname = "Witness Name"
					width = medium
				)
				Phone_Number1
				(
    				type = phonenumber
					displayname = "Phone Number"
					width = medium
					personal data = true
				)
				Witness_Statement
				(
    				type = textarea
					displayname = "Witness Statement"
					height = 100px
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Settlement_Computation
			(
				type = section
				displayname = "Settlement Computation"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have Is_Third_Party
			(
    			type = checkbox
				displayname = "Is Third Party Involved"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Estimated_Repair_Cost
			(
				displayname = "Estimated Repair Cost"
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Depreciation_Percent
			(
    			type = percentage
				displayname = "Depreciation Percent"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Net_Payable_Amount
			(
				type = decimal
				displayname = "Net Payable Amount"
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Repair_Cost - input.Estimated_Repair_Cost * input.Depreciation_Percent / 100
    						visibility = false
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Claim_Process_Guidelines_Display
			(
    			type = richtext
				displayname = "Claim Process Guidelines Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
    			description
    			[
    				type = help_text
    			 	message = "Claim Process Guidelines\n\n• Keep all original bills and estimates.\n• Upload the damage photo and repair estimate.\n• Do not repair the vehicle before inspection.\n• A surveyor will contact you within 48 hours.\n• Sign the declaration before submitting the cl"
    			]
	 			row = 9
	 			column = 1   
				width = medium
			)
			must have Claimant_Digital_Signature
			(
    			type = signature
				displayname = "Claimant Digital Signature"
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Claim_Submitted_On
			(
    			type = datetime
				displayname = "Claim Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Claim_Reference_ID
			(
    			type = autonumber
				displayname = "Claim Reference ID"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Claim Tracking QR Code"
				value = "${Policy_Number}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Submitted","Under Investigation","Approved","Settled","Rejected"}
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Submitted","Document Verification","Investigation","Approved","Settled","Rejected"}
			}
		}
		form Policies
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Policy_Number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Policy_Holder
			(
    			type = text
				displayname = "Policy Holder"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Coverage_Type
			(
    			type = text
				displayname = "Coverage Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Sum_Insured
			(
				type = decimal
				displayname = "Sum Insured"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Valid_Till
			(
    			type = date
				displayname = "Valid Till"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Claim_Request_Form_Report
		{
			displayName = "Claim_Request_Form Report"
			show all rows from Claim_Request_Form    
			(
				Claimant_Type  as "Claimant Name"
				Claimant_Type1 as "Claimant Type"
				Policy_Number as "Policy Number"
				Email
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type as "Claim Type"
				Date_Of_Incident as "Date Of Incident"
				Claim_Amount_Requested as "Claim Amount Requested"
				Supporting_Documents_Available as "Supporting Documents Available"
				Incident_Description as "Incident Description"
				Preferred_Callback_Time as "Preferred Callback Time"
				Declaration_Of_Authenticity as "Declaration Of Authenticity"
				Policy_Details_Lookup as "Policy Details Lookup"
				Damage_Photo as "Damage Photo"
				Repair_Estimate_Upload as "Repair Estimate Upload"
				Policy_Sum_Insured_in_Lakhs as "Policy Sum Insured in Lakhs"
				Witness_Details.Witness_Name as "Witness Details"
				FIR_Copy_Online_Link as "FIR Copy Online Link"
				Accident_Scene_Video as "Accident Scene Video"
				Incident_Voice_Statement as "Incident Voice Statement"
				Is_Third_Party as "Is Third Party Involved"
				Estimated_Repair_Cost as "Estimated Repair Cost"
				Depreciation_Percent as "Depreciation Percent"
				Net_Payable_Amount as "Net Payable Amount"
				Claim_Process_Guidelines_Display as "Claim Process Guidelines Display"
				Claimant_Digital_Signature as "Claimant Digital Signature"
				Claim_Submitted_On as "Claim Submitted On"
				Claim_Reference_ID as "Claim Reference ID"
				QR_Code as "Claim Tracking QR Code"
				Status
			)
		}
		default list Policies_Report
		{
			displayName = "Policies Report"
			show all rows from Policies    
			(
				Policy_Number as "Policy Number"
				Policy_Holder as "Policy Holder"
				Coverage_Type as "Coverage Type"
				Sum_Insured as "Sum Insured"
				Valid_Till as "Valid Till"
			)
		}
		list All_Claims_List
		{
			displayName = "All_Claims_List"
			show all rows from Claim_Request_Form    
			(
				Claimant_Type  as "Claimant Name"
				Claimant_Type1 as "Claimant Type"
				Policy_Number as "Policy Number"
				Email
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Residential_Address  as "Residential Address"
